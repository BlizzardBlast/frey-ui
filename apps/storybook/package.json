{
  "name": "@frey-ui/storybook",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "build": "tsc -b && storybook build --stats-json",
    "typecheck": "tsc -b",
    "lint": "biome lint src .storybook vite.config.ts vitest.setup.ts",
    "format": "biome format --write src .storybook vite.config.ts vitest.setup.ts",
    "format:check": "biome format src .storybook vite.config.ts vitest.setup.ts",
    "preview": "vite preview",
    "storybook": "pnpm dev",
    "build-storybook": "storybook build --stats-json"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "frey-ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@chromatic-com/storybook": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chromatic": "catalog:",
    "jsdom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
