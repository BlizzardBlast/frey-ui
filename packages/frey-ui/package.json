{
  "name": "frey-ui",
  "version": "1.4.0",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/esm/theme.css",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./*": {
      "types": "./dist/types/src/*/index.d.ts",
      "import": "./dist/esm/*/index.mjs",
      "require": "./dist/cjs/*/index.cjs"
    },
    "./theme.css": "./dist/esm/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlizzardBlast/frey-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rimraf dist node_modules/.tmp/tsconfig.lib.tsbuildinfo && rollup -c",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest-axe": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jest-axe": "catalog:",
    "jsdom": "catalog:",
    "magic-string": "catalog:",
    "postcss": "catalog:",
    "postcss-modules": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-peer-deps-external": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
