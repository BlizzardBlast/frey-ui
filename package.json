{
  "name": "frey-ui-monorepo",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.16.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build-storybook --filter=@frey-ui/storybook",
    "dev": "turbo run dev --filter=@frey-ui/storybook",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:staged": "biome check --write --staged --no-errors-on-unmatched",
    "check:changed": "biome ci --changed --since=origin/main --no-errors-on-unmatched .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@frey-ui/playwright",
    "test:coverage": "turbo run test:coverage --filter=frey-ui",
    "playwright:install": "pnpm --filter @frey-ui/playwright exec playwright install chromium",
    "theme:tokens": "node scripts/generate-theme-tokens.mjs",
    "docs:check": "node scripts/check-storybook-api-coverage.mjs",
    "storybook": "turbo run storybook --filter=@frey-ui/storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "ci:changed": "turbo run lint typecheck build --affected && turbo run test --affected --filter=!frey-ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  }
}
